# -*- mode: ruby -*-
# vi: set ft=ruby :

# =============================================================================
# VAGRANTFILE — PRÁCTICA 7: API REST FLASK, MYSQL E IOT UBIDOTS
# =============================================================================
# Asignatura: Ambiente de Desarrollo / Servicios Telemáticos
# Estudiante: Eduard Criollo Yule
# Correo: eduard.criollo@uao.edu.co
# =============================================================================

Vagrant.configure("2") do |config|
  config.vm.boot_timeout = 600

  # Configuración global del hipervisor VirtualBox
  config.vm.provider "virtualbox" do |vb|
    vb.name = "servidorRest-Practica7"
    vb.memory = "1024"
    vb.cpus = 1
  end

  # ===========================================================================
  # Nodo: servidorRest (Ubuntu 22.04 LTS)
  # Aloja el microservicio API REST Flask, la base de datos MySQL y el cliente IoT
  # ===========================================================================
  config.vm.define :servidorRest do |nodo|
    nodo.vm.box = "bento/ubuntu-22.04"
    nodo.vm.hostname = "servidorRest"

    # 1. Red privada Host-Only
    nodo.vm.network :private_network, ip: "192.168.50.3"

    # 2. Redirección de puertos (Port Forwarding) para pruebas locales desde Windows
    # Permite acceder tanto vía http://192.168.50.3:5000 como http://localhost:5000
    nodo.vm.network :forwarded_port, guest: 5000, host: 5000, auto_correct: true

    # 3. Aprovisionamiento automatizado de infraestructura y servicios
    nodo.vm.provision "shell", inline: <<-SHELL
      echo "=== [servidorRest] 1. Actualizando repositorios APT ==="
      sudo apt-get update -y

      echo "=== [servidorRest] 2. Instalando dependencias del sistema y Python ==="
      sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
        python3 \
        python3-pip \
        python3-venv \
        python3-dev \
        python3-flask \
        python3-requests \
        python3-pymysql \
        default-libmysqlclient-dev \
        dos2unix \
        curl \
        git \
        mysql-server || sudo DEBIAN_FRONTEND=noninteractive apt-get install -y python3-pip python3-flask curl git mysql-server

      echo "=== [servidorRest] 3. Instalando paquetes Python requeridos ==="
      # Se utiliza --ignore-installed para prevenir el error 'uninstall-distutils-installed-package' con blinker en Ubuntu 22.04
      sudo pip3 install --ignore-installed blinker Flask requests PyMySQL cryptography python-dotenv

      echo "=== [servidorRest] 4. Verificando versión instalada de Flask ==="
      python3 -c "import flask; print('Flask version:', flask.__version__)"

      echo "=== [servidorRest] 5. Inicializando servicio y base de datos MySQL ==="
      sudo systemctl enable mysql
      sudo systemctl restart mysql

      # Ejecutar script DDL/DML si existe en la carpeta compartida /vagrant
      if [ -f "/vagrant/config/schema.sql" ]; then
        echo "=== [servidorRest] Cargando esquema SQL myflaskapp.books ==="
        sed -i 's/\r$//' /vagrant/config/schema.sql 2>/dev/null || true
        sudo mysql < /vagrant/config/schema.sql 2>/dev/null || true
      fi

      echo "=== [servidorRest] 6. Configurando repositorios de código en /home/vagrant ==="
      mkdir -p /home/vagrant/APIRestFlask /home/vagrant/UbidotsClient
      if [ -d "/vagrant/APIRestFlask" ]; then
        cp -r /vagrant/APIRestFlask/* /home/vagrant/APIRestFlask/ 2>/dev/null || true
      fi
      if [ -d "/vagrant/UbidotsClient" ]; then
        cp -r /vagrant/UbidotsClient/* /home/vagrant/UbidotsClient/ 2>/dev/null || true
      fi

      # Normalizar saltos de línea Windows (CRLF -> LF) por si el repositorio fue clonado en Windows
      find /home/vagrant/APIRestFlask /home/vagrant/UbidotsClient -type f \( -name "*.py" -o -name "*.sh" -o -name "*.sql" \) -exec sed -i 's/\r$//' {} + 2>/dev/null || true
      if [ -d "/vagrant/scripts" ]; then
        find /vagrant/scripts -type f -name "*.sh" -exec sed -i 's/\r$//' {} + 2>/dev/null || true
        chmod +x /vagrant/scripts/*.sh 2>/dev/null || true
      fi

      # Clonar repositorios de referencia si están disponibles
      if [ ! -d "/home/vagrant/APIRestFlask_upstream" ]; then
        git clone https://github.com/omondragon/APIRestFlask.git /home/vagrant/APIRestFlask_upstream 2>/dev/null || true
      fi
      if [ ! -d "/home/vagrant/UbidotsClient_upstream" ]; then
        git clone https://github.com/omondragon/UbidotsClient.git /home/vagrant/UbidotsClient_upstream 2>/dev/null || true
      fi

      sudo chown -R vagrant:vagrant /home/vagrant/APIRestFlask /home/vagrant/UbidotsClient

      echo "=== [servidorRest] 7. Registrando y arrancando servicio systemd apirest.service ==="
      if [ -f "/vagrant/config/apirest.service" ]; then
        sudo cp /vagrant/config/apirest.service /etc/systemd/system/apirest.service
        sudo sed -i 's/\r$//' /etc/systemd/system/apirest.service
        sudo systemctl daemon-reload
        sudo systemctl enable apirest.service
        sudo systemctl restart apirest.service
      fi

      echo "=== [servidorRest] Aprovisionamiento completado con éxito ==="
      echo "API REST escuchando en http://192.168.50.3:5000 y http://localhost:5000"
    SHELL
  end
end
