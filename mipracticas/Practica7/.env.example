# =============================================================================
# VARIABLES DE ENTORNO — PRÁCTICA 7: API REST FLASK E IOT UBIDOTS
# =============================================================================
# Copie este archivo como .env y complete sus valores locales.
# NUNCA suba su archivo .env con tokens o contraseñas reales al repositorio.

# Configuración del Microservicio API REST Flask (Parte 1)
FLASK_APP=apirest.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Configuración de Base de Datos MySQL (Respaldo Práctico de Contenidos)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=flaskuser
MYSQL_PASSWORD=flaskpassword
MYSQL_DATABASE=myflaskapp
MYSQL_ROOT_PASSWORD=root

# Configuración de Plataforma IoT Ubidots (Parte 2)
# Obtenga su token en Ubidots: Profile -> API Credentials -> Default Token
UBIDOTS_TOKEN=BBFF-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
UBIDOTS_DEVICE_LABEL=machine
UBIDOTS_BASE_URL=http://industrial.api.ubidots.com
