# -*- mode: ruby -*-
# vi: set ft=ruby :
# =============================================================================
# PRÁCTICA 9: APLICACIÓN WEB Y API REST EN PYTHON FLASK + MYSQL + APACHE WSGI
# Asignatura: Ambiente de Desarrollo / Servicios Telemáticos
# Estudiante: Eduard Criollo Yule
