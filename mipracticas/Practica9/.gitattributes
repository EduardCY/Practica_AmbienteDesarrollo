# =============================================================================
# ATRIBUTOS GIT — NORMALIZACIÓN DE SALTOS DE LÍNEA (PRÁCTICA 9)
# =============================================================================
# Garantiza que al clonar el repositorio en Windows, los scripts de shell,
# archivos de servicio systemd, configuraciones de Apache WSGI y código Python
# conserven finales de línea LF (Unix) dentro de la máquina virtual Ubuntu.

* text=auto

# Scripts de aprovisionamiento y pruebas en Linux
*.sh text eol=lf

# Archivos de configuración de servicios, Apache, SQL y entorno
*.service text eol=lf
*.conf text eol=lf
*.wsgi text eol=lf
*.sql text eol=lf
*.env.example text eol=lf
Vagrantfile text eol=lf

# Código fuente Python, plantillas HTML y scripts JS
*.py text eol=lf
*.html text eol=lf
*.js text eol=lf
*.txt text eol=lf

# Scripts de PowerShell para host Windows
*.ps1 text eol=crlf

# Archivos binarios (imágenes, documentos y videos)
*.png binary
*.jpg binary
*.pdf binary
*.mp4 binary
