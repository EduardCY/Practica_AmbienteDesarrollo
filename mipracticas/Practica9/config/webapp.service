[Unit]
Description=MiniWebApp Flask + REST + MySQL Service (Practica 9)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=vagrant
Group=vagrant
WorkingDirectory=/home/vagrant/webapp
Environment="FLASK_APP=run.py"
Environment="FLASK_ENV=development"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /home/vagrant/webapp/run.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
