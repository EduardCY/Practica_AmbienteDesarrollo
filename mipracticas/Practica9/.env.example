# =============================================================================
# VARIABLES DE ENTORNO — PRÁCTICA 9: APLICACIÓN WEB + API REST FLASK + MYSQL + APACHE WSGI
# =============================================================================
# Copie este archivo como .env si desea personalizar parámetros locales.
# NUNCA suba credenciales de producción al repositorio público.

# Configuración del Servidor Flask / WSGI
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Configuración de Persistencia Relacional MySQL 8.0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=myflaskapp

# Usuario dedicado opcional de aplicación (Principio de mínimo privilegio)
APP_DB_USER=flaskuser
APP_DB_PASSWORD=flaskpassword
