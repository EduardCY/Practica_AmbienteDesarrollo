# =============================================================================
# VARIABLES DE ENTORNO — PRÁCTICA 11: AWS EC2 (APACHE + API REST FLASK)
# =============================================================================
# Copie este archivo como .env para parametrizar las pruebas locales o scripts.
# NOTA: Nunca almacene credenciales reales ni llaves privadas (.pem) en el repositorio.

# Direcciones IP públicas asignadas dinámicamente en AWS EC2 (us-east-1)
VM1_PUBLIC_IP=52.91.99.132
VM1_PRIVATE_IP=172.31.16.58
VM2_PUBLIC_IP=54.221.25.113
VM2_PRIVATE_IP=172.31.23.119

# Ruta local absoluta o relativa a la llave SSH (.pem) en su equipo Windows
# Se recomienda ubicar la llave en %USERPROFILE%\.ssh\ o en una carpeta externa segura.
SSH_KEY_PATH=C:\Users\eduar\.ssh\practica11-key.pem

# Repositorio remoto para el aprovisionamiento automático (Modo A User Data)
REPO_URL=https://github.com/EduardCY/Practica_AmbienteDesarrollo.git
REPO_BRANCH=main

# Puerto del microservicio Flask
API_PORT=5000
