# Forzar finales de línea LF para scripts de shell, servicios systemd y configuraciones Linux
*.sh text eol=lf
*.py text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.md text eol=lf

# Scripts de Windows PowerShell en CRLF
*.ps1 text eol=crlf
